# Documentation only. Run scripts/setup_local.py to generate private credentials.
# Never copy real credentials into this file.
NEWTON_POSTGRES_PASSWORD=GENERATE_WITH_SETUP
NEWTON_DATABASE_URL=postgresql+psycopg://newton:GENERATE_WITH_SETUP@127.0.0.1:15432/newton
NEWTON_WEAVIATE_API_KEY=GENERATE_WITH_SETUP
NEWTON_DATA_DIR=.runtime/data
NEWTON_BUDGET_PATH=.runtime/budget.json
NEWTON_COOKIE_SECURE=false
# OPENAI_API_KEY and GEMINI_API_KEY are injected through the process environment.

# Optional private ColQwen service; never use a public endpoint.
NEWTON_VISUAL_ENCODER_URL=
